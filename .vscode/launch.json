    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "swift",
            "request": "attach",
            "name": "Attach to Swift Executable",
            "program": "${workspaceRoot}/.build/debug/<program>"
        },
        {
            "type": "swift",
            "request": "launch",
            "name": "Launch Swift Executable",
            "program": "${workspaceRoot}/.build/debug/<program>",
            "args": [],
            "env": {},
            "cwd": "${workspaceRoot}"
        },
        {
            "type": "swift",
            "request": "attach",
            "name": "Attach to Swift Executable",
            "pid": "${command:pickProcess}"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/<your program>",
            "args": [],
            "env": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}